# Copy this file to .env.prod on the VPS and fill real values there.
# Run:
# docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

NODE_ENV=production

APP_DOMAIN=example.com
API_DOMAIN=api.example.com
CLIENT_URL=https://example.com
PUBLIC_API_URL=https://api.example.com
NGINX_HTTP_PORT=80
COOKIE_SECURE=true

ACCESS_TOKEN_SECRET=change_me_to_a_long_random_value
REFRESH_TOKEN_SECRET=change_me_to_a_different_long_random_value

POSTGRES_NAME=stripe_app
POSTGRES_USER=stripe_user
POSTGRES_PASSWORD=change_me_to_a_strong_database_password
POSTGRES_SYNCHRONIZE=false

STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me
STRIPE_API_URL=https://api.stripe.com
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_change_me

BACKEND_IMAGE=stripe-project-backend:prod
FRONTEND_IMAGE=stripe-project-frontend:prod
