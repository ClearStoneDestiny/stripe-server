# Local Docker Compose defaults.
# Usage:
# docker compose --env-file .env.compose up --build

NODE_ENV=development

FRONTEND_PORT=5173
BACKEND_PORT=3000
POSTGRES_HOST_PORT=5433

CLIENT_URL=http://localhost:5173
VITE_BACKEND_DOMAIN=http://localhost:3000

ACCESS_TOKEN_SECRET=local_access_token_secret_change_me
REFRESH_TOKEN_SECRET=local_refresh_token_secret_change_me

POSTGRES_NAME=stripe_app
POSTGRES_USER=stripe_user
POSTGRES_PASSWORD=stripe_password
POSTGRES_SYNCHRONIZE=true

# Use real Stripe test values when you want to test checkout/webhooks.
STRIPE_SECRET_KEY=sk_test_local_dummy_key
STRIPE_WEBHOOK_SECRET=whsec_local_dummy_secret
STRIPE_API_URL=https://api.stripe.com
VITE_STRIPE_PUBLISHABLE_KEY=
