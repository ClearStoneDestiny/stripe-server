# Local prod-like Docker Compose profile.
# It keeps the same topology as production: only Nginx is public.
#
# Open the app at:
# http://app.localhost:8080
#
# API is routed by Nginx at:
# http://app.localhost:8080/api

NODE_ENV=development

APP_DOMAIN=app.localhost
API_DOMAIN=api.localhost
CLIENT_URL=http://app.localhost:8080
PUBLIC_API_URL=http://app.localhost:8080/api
NGINX_HTTP_PORT=8080

ACCESS_TOKEN_SECRET=local_access_token_secret_change_me
REFRESH_TOKEN_SECRET=local_refresh_token_secret_change_me

POSTGRES_NAME=stripe_app
POSTGRES_USER=stripe_user
POSTGRES_PASSWORD=change_me_to_a_strong_database_password
POSTGRES_SYNCHRONIZE=true

STRIPE_SECRET_KEY=sk_test_local_dummy_key
STRIPE_WEBHOOK_SECRET=whsec_local_dummy_secret
STRIPE_API_URL=https://api.stripe.com
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_local_dummy_key

BACKEND_IMAGE=stripe-project-backend:prod
FRONTEND_IMAGE=stripe-project-frontend:prod
